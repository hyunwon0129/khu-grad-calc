# 이 파일을 .env.local로 복사해서 값을 채우세요. (.env.local은 git에 올라가지 않습니다)
# 값이 비어 있으면 로그인 기능이 숨겨지고 로컬 전용으로 동작합니다.

# Supabase 대시보드 → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# 공개용 anon(public) 키. service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_ANON_KEY=

# 켤 소셜 로그인 (쉼표 구분: kakao,google). 이메일 링크 로그인은 항상 켜집니다.
VITE_AUTH_PROVIDERS=kakao
